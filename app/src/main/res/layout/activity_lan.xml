<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="8dp"
        android:paddingRight="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="‹ 返回"
            android:textSize="15sp"
            android:textColor="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="局域网互传"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/lanTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="不经过服务器"
            android:textSize="11sp"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/cardHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_pill_gray">

                <TextView
                    android:id="@+id/hostTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="① 我的房间（本机做主机）"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="开启后，同 Wi-Fi 下的手机和浏览器输入地址 + 口令即可加入互传"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="口令位数"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/len4"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginLeft="10dp"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="4 位"
                        android:textSize="12sp"
                        android:background="@drawable/bg_pill_filled" />

                    <TextView
                        android:id="@+id/len5"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginLeft="6dp"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="5 位"
                        android:textSize="12sp"
                        android:background="@drawable/bg_pill" />

                    <TextView
                        android:id="@+id/len6"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginLeft="6dp"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:text="6 位"
                        android:textSize="12sp"
                        android:background="@drawable/bg_pill" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnHostToggle"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="开启房间"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_pill_filled" />

                <TextView
                    android:id="@+id/hostStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="房间未开启"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/codeText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="----"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.2" />

                <TextView
                    android:id="@+id/addrText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="开启后显示局域网地址"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/qrImage"
                    android:layout_width="196dp"
                    android:layout_height="196dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:background="#FFFFFFFF"
                    android:contentDescription="房间二维码"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/qrHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="扫一扫即可直接加入本房间"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/peerText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="在线 0 人"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/btnCopyAddr"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="复制地址+口令"
                        android:textSize="12sp"
                        android:background="@drawable/bg_pill" />

                    <TextView
                        android:id="@+id/btnAddLocal"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:gravity="center"
                        android:text="添加本机文件"
                        android:textSize="12sp"
                        android:background="@drawable/bg_pill" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardGuest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_pill_gray">

                <TextView
                    android:id="@+id/guestTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="② 加入别人的房间"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputAddr"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:hint="http://192.168.1.5:23456"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:inputType="textUri"
                    android:background="@drawable/bg_input" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/inputCode"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:hint="房间口令"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:inputType="number"
                        android:maxLength="8"
                        android:background="@drawable/bg_input" />

                    <EditText
                        android:id="@+id/inputName"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:hint="我的昵称"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:maxLength="20"
                        android:background="@drawable/bg_input" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnJoinRoom"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="加入房间"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_pill_filled" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/btnScanJoin"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="扫码加入"
                        android:textSize="12sp"
                        android:background="@drawable/bg_pill" />

                    <TextView
                        android:id="@+id/btnUploadFile"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="6dp"
                        android:gravity="center"
                        android:text="上传文件"
                        android:textSize="12sp"
                        android:background="@drawable/bg_pill" />

                    <TextView
                        android:id="@+id/btnLeaveRoom"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="6dp"
                        android:gravity="center"
                        android:text="退出房间"
                        android:textSize="12sp"
                        android:background="@drawable/bg_pill" />
                </LinearLayout>

                <TextView
                    android:id="@+id/guestStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="未加入房间"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_pill_gray">

                <TextView
                    android:id="@+id/chatTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="③ 房间消息"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <ScrollView
                        android:id="@+id/chatScroll"
                        android:layout_width="match_parent"
                        android:layout_height="360dp"
                        android:background="@drawable/bg_input_gray"
                        android:padding="8dp">

                        <LinearLayout
                            android:id="@+id/chatBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>

                    <TextView
                        android:id="@+id/btnNewMsg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_alignParentBottom="true"
                        android:layout_margin="12dp"
                        android:gravity="center"
                        android:paddingLeft="14dp"
                        android:paddingRight="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="↓ 新消息"
                        android:textSize="12sp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_pill_filled"
                        android:visibility="gone" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <EditText
                        android:id="@+id/chatInput"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"
                        android:hint="说点什么…"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:background="@drawable/bg_input" />

                    <TextView
                        android:id="@+id/btnSendText"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginLeft="8dp"
                        android:gravity="center"
                        android:paddingLeft="20dp"
                        android:paddingRight="20dp"
                        android:text="发送"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_pill_filled" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/btnUpFile"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="上传文件"
                        android:textSize="12sp"
                        android:background="@drawable/bg_pill" />

                    <TextView
                        android:id="@+id/btnUpFolder"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:gravity="center"
                        android:text="上传文件夹"
                        android:textSize="12sp"
                        android:background="@drawable/bg_pill" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="口令随机生成且不等于端口号 · 数据仅在局域网内传输"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
